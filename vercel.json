{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-chat": {
      "root": "artifacts/ai-chat",
      "framework": "vite",
      "installCommand": "cd ../.. && npx --yes pnpm@10.26.1 install --frozen-lockfile --prod=false",
      "buildCommand": "PORT=5000 BASE_PATH=/ npx --yes pnpm@10.26.1 run build",
      "outputDirectory": "dist/public",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "cd ../.. && npx --yes pnpm@10.26.1 install --frozen-lockfile --prod=false",
      "buildCommand": "npx --yes pnpm@10.26.1 run build",
      "functions": {
        "src/app.ts": {
          "maxDuration": 180,
          "supportsCancellation": true
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "ai-chat" } }
  ]
}
